{
  "name": "@open-ccw/open-ccw",
  "private": true,
  "version": "0.0.4",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler dev",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run check && npm run format:check && npm run build",
    "gen": "wrangler types",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types ./worker-configuration.d.ts",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "devDependencies": {
    "@open-ccw/scratch-vm": "^9.9.18",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "wrangler": "^4.160.0"
  },
  "dependencies": {
    "@ccw-api/api": "^2.1.15",
    "@ccw-api/request": "^1.2.3",
    "@mixer/postmessage-rpc": "^1.1.4",
    "@open-ccw/player": "^0.0.5",
    "dompurify": "^3.4.17",
    "js-md5": "^0.9.2",
    "marked": "^18.2.0",
    "svelte-portal": "^2.2.1"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261103.1": true
  }
}
