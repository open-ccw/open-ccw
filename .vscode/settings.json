{
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "prettier.tabWidth": 2,
  "editor.tabSize": 2,
  "editor.formatOnSave": true,
  "editor.quickSuggestions": {
    "other": false,
    "comments": true,
    "strings": "off"
  },
  "typescript.tsdk": "node_modules\\typescript\\lib",
  "search.exclude": {
    "**/node_modules": true,
    "**/.svelte-kit": true,
    "**/.wrangler": true
  },
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true
}
